{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "edge-proxy values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag"
      ],
      "additionalProperties": false
    },
    "bootstrapImage": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "required": [
        "repository",
        "tag"
      ],
      "additionalProperties": false
    },
    "hostNetwork": {
      "type": "boolean"
    },
    "updateStrategy": {
      "type": "object"
    },
    "xds": {
      "type": "object",
      "properties": {
        "controlPlaneHost": {
          "type": "string"
        },
        "controlPlanePort": {
          "type": "integer"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "mountPath": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extAuthz": {
      "type": "object",
      "properties": {
        "clientTLS": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "mountPath": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "certificate": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "issuerRef": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "ClusterIssuer",
                "Issuer"
              ]
            },
            "group": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "renewBefore": {
          "type": "string",
          "minLength": 1
        },
        "serving": {
          "type": "object",
          "properties": {
            "dnsNames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "duration": {
              "type": "string",
              "minLength": 1
            },
            "renewBefore": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
